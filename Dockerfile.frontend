# Build da aplicação React para produção.
FROM node:18-alpine AS build

WORKDIR /app

COPY package*.json ./
# A instalação fica separada para aproveitar melhor o cache de camadas.
RUN npm ci

COPY public ./public
COPY src ./src

ARG REACT_APP_API_URL=http://localhost:8001
ENV REACT_APP_API_URL=${REACT_APP_API_URL}

RUN npm run build

# Runtime enxuto usando nginx para servir os arquivos estáticos.
FROM nginx:1.27-alpine AS runtime

COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html

EXPOSE 80

# O healthcheck final é definido no docker-compose porque ele representa
# a forma como este container será usado no ambiente local do projeto.

CMD ["nginx", "-g", "daemon off;"]
