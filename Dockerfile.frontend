# Build da aplicação React para produção.
FROM node:18-alpine AS build

WORKDIR /app

COPY package*.json ./
# A instalação fica separada para aproveitar melhor o cache de camadas.
RUN npm ci

COPY public ./public
COPY src ./src

ARG REACT_APP_API_URL=http://localhost:8001
ENV REACT_APP_API_URL=${REACT_APP_API_URL}

RUN npm run build

# Runtime enxuto usando nginx em modo não-root para servir os arquivos estáticos.
# Isso reduz privilégio desnecessário no container final.
FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime

COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html

EXPOSE 8080

# Declaramos o healthcheck também no Dockerfile para que `docker run`
# e pipelines isolados recebam o mesmo contrato básico do Compose.
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=5 \
  CMD wget --spider -q http://127.0.0.1:8080 || exit 1

CMD ["nginx", "-g", "daemon off;"]
